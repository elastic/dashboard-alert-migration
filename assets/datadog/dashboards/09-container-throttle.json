{
  "title": "Container CPU throttle",
  "description": "Container CPU throttle \u2014 metrics adoption workshop board (What & why note at top).",
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "### What this dashboard shows\nContainer CPU throttle/usage, memory, network, restarts, OOM, and filesystem usage by container name.\n\n### Why it matters for metrics adoption\nContainer saturation is a modern metrics-adoption priority; this board exercises container_* series after OTel mapping.",
        "background_color": "white",
        "font_size": "14",
        "text_align": "left",
        "show_tick": false,
        "tick_pos": "50%",
        "tick_edge": "left",
        "vertical_align": "top"
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "CPU throttled",
        "requests": [
          {
            "q": "avg:container.cpu.throttled{*} by {container_name}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 3,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "CPU usage",
        "requests": [
          {
            "q": "avg:container.cpu.usage{*} by {container_name}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 3,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "CPU user",
        "requests": [
          {
            "q": "avg:container.cpu.user{*} by {container_name}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 7,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "CPU system",
        "requests": [
          {
            "q": "avg:container.cpu.system{*} by {container_name}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 7,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Mem usage",
        "requests": [
          {
            "q": "avg:container.memory.usage{*} by {container_name}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 11,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Mem limit",
        "requests": [
          {
            "q": "avg:container.memory.limit{*} by {container_name}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 11,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Network RX",
        "requests": [
          {
            "q": "sum:container.net.rcvd{*} by {container_name}.as_rate()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 15,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Network TX",
        "requests": [
          {
            "q": "sum:container.net.sent{*} by {container_name}.as_rate()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 15,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Restarts",
        "requests": [
          {
            "q": "sum:container.restarts{*} by {container_name}.as_count()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 19,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "CPU shares",
        "requests": [
          {
            "q": "avg:container.cpu.shares{*} by {container_name}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 19,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "OOM kills",
        "requests": [
          {
            "q": "sum:container.oom_events{*} by {container_name}.as_count()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 23,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Filesystem usage",
        "requests": [
          {
            "q": "avg:container.filesystem.usage{*} by {container_name}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 23,
        "width": 6,
        "height": 4
      }
    }
  ],
  "template_variables": [
    {
      "name": "env",
      "default": "*",
      "prefix": "env"
    }
  ]
}
