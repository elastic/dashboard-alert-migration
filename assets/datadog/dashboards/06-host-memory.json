{
  "title": "Host memory",
  "description": "Host memory \u2014 metrics adoption workshop board (What & why note at top).",
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "### What this dashboard shows\nUsable/used/free memory, swap, slab, page faults, buffers/cache, and commit limit proxies by host.\n\n### Why it matters for metrics adoption\nMemory pressure boards are a must-have for infra metrics on Elastic once hosts emit OTel system metrics.",
        "background_color": "white",
        "font_size": "14",
        "text_align": "left",
        "show_tick": false,
        "tick_pos": "50%",
        "tick_edge": "left",
        "vertical_align": "top"
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Mem pct usable",
        "requests": [
          {
            "q": "avg:system.mem.pct_usable{*} by {host}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 3,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Mem used",
        "requests": [
          {
            "q": "avg:system.mem.used{*} by {host}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 3,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Mem free",
        "requests": [
          {
            "q": "avg:system.mem.free{*} by {host}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 7,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Swap used",
        "requests": [
          {
            "q": "avg:system.swap.used{*} by {host}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 7,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Swap pct",
        "requests": [
          {
            "q": "avg:system.swap.pct_free{*} by {host}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 11,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Slab",
        "requests": [
          {
            "q": "avg:system.mem.slab{*} by {host}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 11,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Page faults",
        "requests": [
          {
            "q": "sum:system.mem.page_faults{*} by {host}.as_rate()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 15,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Buffers",
        "requests": [
          {
            "q": "avg:system.mem.buffered{*} by {host}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 15,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Cached",
        "requests": [
          {
            "q": "avg:system.mem.cached{*} by {host}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 19,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Total memory",
        "requests": [
          {
            "q": "avg:system.mem.total{*} by {host}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 19,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Usable bytes",
        "requests": [
          {
            "q": "avg:system.mem.usable{*} by {host}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 23,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Commit limit proxy",
        "requests": [
          {
            "q": "avg:system.mem.commit_limit{*} by {host}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 23,
        "width": 6,
        "height": 4
      }
    }
  ],
  "template_variables": [
    {
      "name": "env",
      "default": "*",
      "prefix": "env"
    }
  ]
}
