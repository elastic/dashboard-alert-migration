{
  "title": "Log error spike",
  "description": "Log error spike \u2014 metrics adoption workshop board (What & why note at top).",
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "### What this dashboard shows\nLog-query widgets for error/warn spikes by path/service/namespace plus related trace and disk context metrics.\n\n### Why it matters for metrics adoption\nShows metrics+logs together \u2014 a key adoption story for customers already shipping logs to Elastic who want metrics and log signals on one board.\n\n### Notes\nLog widgets may need index/field tuning after migrate; metric widgets use the OTLP fleet.",
        "background_color": "white",
        "font_size": "14",
        "text_align": "left",
        "show_tick": false,
        "tick_pos": "50%",
        "tick_edge": "left",
        "vertical_align": "top"
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Errors by path",
        "requests": [
          {
            "q": "logs(\"status:error\").index(\"*\").rollup(\"count\").by(\"@http.url_details.path\")",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 3,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Errors by service",
        "requests": [
          {
            "q": "logs(\"status:error\").index(\"*\").rollup(\"count\").by(\"service\")",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 3,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "All levels by service",
        "requests": [
          {
            "q": "logs(\"*\").index(\"*\").rollup(\"count\").by(\"service\")",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 7,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Warn + error",
        "requests": [
          {
            "q": "logs(\"status:warn OR status:error\").index(\"*\").rollup(\"count\").by(\"service\")",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 7,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "By kube namespace",
        "requests": [
          {
            "q": "logs(\"*\").index(\"*\").rollup(\"count\").by(\"kube_namespace\")",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 11,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Security proxy",
        "requests": [
          {
            "q": "logs(\"source:security\").index(\"*\").rollup(\"count\").by(\"service\")",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 11,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Apache errors",
        "requests": [
          {
            "q": "logs(\"source:apache\").index(\"*\").rollup(\"count\").by(\"host\")",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 15,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Nginx access proxy",
        "requests": [
          {
            "q": "logs(\"source:nginx\").index(\"*\").rollup(\"count\").by(\"http.url\")",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 15,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Trace errors",
        "requests": [
          {
            "q": "sum:trace.http.request.errors{*} by {service}.as_count()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 19,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "HTTP hits context",
        "requests": [
          {
            "q": "sum:trace.http.request.hits{*} by {service}.as_count()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 19,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Duration during spikes",
        "requests": [
          {
            "q": "avg:trace.http.request.duration{*} by {service}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 23,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Disk IO proxy",
        "requests": [
          {
            "q": "avg:system.disk.io{*} by {host}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 23,
        "width": 6,
        "height": 4
      }
    }
  ],
  "template_variables": [
    {
      "name": "env",
      "default": "*",
      "prefix": "env"
    }
  ]
}
