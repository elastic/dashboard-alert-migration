{
  "title": "Disk I/O",
  "description": "Disk I/O \u2014 metrics adoption workshop board (What & why note at top).",
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "### What this dashboard shows\nDisk utilization, read/write bytes and ops, queue length, and filesystem free/inode proxies by device/host.\n\n### Why it matters for metrics adoption\nStorage metrics complete the host triad (CPU/mem/disk) for metrics adoption and capacity planning on Elastic.",
        "background_color": "white",
        "font_size": "14",
        "text_align": "left",
        "show_tick": false,
        "tick_pos": "50%",
        "tick_edge": "left",
        "vertical_align": "top"
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Disk IO avg",
        "requests": [
          {
            "q": "avg:system.disk.io{*} by {device}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 3,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Disk in use",
        "requests": [
          {
            "q": "avg:system.disk.in_use{*} by {device}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 3,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Read bytes",
        "requests": [
          {
            "q": "sum:system.disk.read_bytes{*} by {device}.as_rate()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 7,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Write bytes",
        "requests": [
          {
            "q": "sum:system.disk.write_bytes{*} by {device}.as_rate()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 7,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Read time",
        "requests": [
          {
            "q": "avg:system.disk.read_time_pct{*} by {device}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 11,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Write time",
        "requests": [
          {
            "q": "avg:system.disk.write_time_pct{*} by {device}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 11,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Queue length",
        "requests": [
          {
            "q": "avg:system.disk.queue_size{*} by {device}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 15,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "IOPS read",
        "requests": [
          {
            "q": "sum:system.disk.read_ops{*} by {device}.as_rate()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 15,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "IOPS write",
        "requests": [
          {
            "q": "sum:system.disk.write_ops{*} by {device}.as_rate()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 19,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Filesystem free %",
        "requests": [
          {
            "q": "avg:system.disk.free{*} by {device}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 19,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Inode usage",
        "requests": [
          {
            "q": "avg:system.disk.in_use{*} by {host}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 23,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "IO utilization",
        "requests": [
          {
            "q": "avg:system.io.util{*} by {device}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 23,
        "width": 6,
        "height": 4
      }
    }
  ],
  "template_variables": [
    {
      "name": "env",
      "default": "*",
      "prefix": "env"
    }
  ]
}
