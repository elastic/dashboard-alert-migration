{
  "title": "Error budget view",
  "description": "Error budget view \u2014 metrics adoption workshop board (What & why note at top).",
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "### What this dashboard shows\nError and hit volume, breakdowns by service/resource/status, burn-style hit series, and latency alongside errors.\n\n### Why it matters for metrics adoption\nError-budget thinking is a common metrics-adoption goal; this board shows how Datadog-shaped monitors and charts can drive the same conversation on Elastic.",
        "background_color": "white",
        "font_size": "14",
        "text_align": "left",
        "show_tick": false,
        "tick_pos": "50%",
        "tick_edge": "left",
        "vertical_align": "top"
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "HTTP errors total",
        "requests": [
          {
            "q": "sum:trace.http.request.errors{*}.as_count()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 3,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "HTTP hits total",
        "requests": [
          {
            "q": "sum:trace.http.request.hits{*}.as_count()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 3,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Errors by service",
        "requests": [
          {
            "q": "sum:trace.http.request.errors{*} by {service}.as_count()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 7,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Errors by resource",
        "requests": [
          {
            "q": "sum:trace.http.request.errors{*} by {resource_name}.as_count()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 7,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "5xx rate proxy",
        "requests": [
          {
            "q": "sum:trace.http.request.errors{*} by {http.status_code}.as_count()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 11,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Client errors",
        "requests": [
          {
            "q": "sum:trace.http.client.errors{*} by {service}.as_count()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 11,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Failed spans",
        "requests": [
          {
            "q": "sum:trace.spans.finished{*} by {service}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 15,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Error budget burn (hits)",
        "requests": [
          {
            "q": "sum:trace.http.request.hits{*} by {service}.as_count()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 15,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Latency on errors",
        "requests": [
          {
            "q": "avg:trace.http.request.duration{*} by {service}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 19,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Apdex",
        "requests": [
          {
            "q": "avg:app.apdex.score{*} by {service}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 19,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Log-style error spike",
        "requests": [
          {
            "q": "sum:trace.http.request.errors{*} by {host}.as_count()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 23,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Availability proxy \u2014 hits",
        "requests": [
          {
            "q": "sum:trace.http.request.hits{*} by {host}.as_count()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 23,
        "width": 6,
        "height": 4
      }
    }
  ],
  "template_variables": [
    {
      "name": "env",
      "default": "*",
      "prefix": "env"
    }
  ]
}
