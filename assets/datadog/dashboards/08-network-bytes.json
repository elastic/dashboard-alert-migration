{
  "title": "Network bytes",
  "description": "Network bytes \u2014 metrics adoption workshop board (What & why note at top).",
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "### What this dashboard shows\nInterface byte/packet rates, TCP retransmits, UDP/errors, connection counts, plus HTTP/DNS traffic context.\n\n### Why it matters for metrics adoption\nNetwork metrics explain many app symptoms; adopting them on Elastic closes the gap between host and service views.",
        "background_color": "white",
        "font_size": "14",
        "text_align": "left",
        "show_tick": false,
        "tick_pos": "50%",
        "tick_edge": "left",
        "vertical_align": "top"
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Bytes sent rate",
        "requests": [
          {
            "q": "sum:system.net.bytes_sent{*} by {interface}.as_rate()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 3,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Bytes rcvd rate",
        "requests": [
          {
            "q": "sum:system.net.bytes_rcvd{*} by {interface}.as_rate()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 3,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "TCP retransmits",
        "requests": [
          {
            "q": "sum:system.net.tcp.retrans_segs{*} by {host}.as_rate()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 7,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "UDP errors",
        "requests": [
          {
            "q": "sum:system.net.udp.in_errors{*} by {host}.as_rate()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 7,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Packets in",
        "requests": [
          {
            "q": "sum:system.net.packets_in.count{*} by {interface}.as_rate()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 11,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Packets out",
        "requests": [
          {
            "q": "sum:system.net.packets_out.count{*} by {interface}.as_rate()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 11,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Connection count",
        "requests": [
          {
            "q": "avg:system.net.tcp.connections{*} by {host}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 15,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Listen overflows",
        "requests": [
          {
            "q": "sum:system.net.tcp.listen_overflows{*} by {host}.as_rate()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 15,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "HTTP traffic proxy",
        "requests": [
          {
            "q": "sum:trace.http.request.hits{*} by {service}.as_count()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 19,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "DNS latency proxy",
        "requests": [
          {
            "q": "avg:trace.dns.lookup.duration{*} by {service}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 19,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Net errors in",
        "requests": [
          {
            "q": "sum:system.net.errors_in{*} by {interface}.as_rate()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 23,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Net errors out",
        "requests": [
          {
            "q": "sum:system.net.errors_out{*} by {interface}.as_rate()",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 23,
        "width": 6,
        "height": 4
      }
    }
  ],
  "template_variables": [
    {
      "name": "env",
      "default": "*",
      "prefix": "env"
    }
  ]
}
